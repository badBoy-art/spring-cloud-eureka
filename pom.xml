        <!-- 这里原本重复声明了 commons-io 2.6（后声明的覆盖先声明的，Maven 也会报
             "'groupId:artifactId' must be unique"）。drools-decisiontables 传递进来的 POI 5.4.1
             需要新版 commons-io（UnsynchronizedByteArrayOutputStream.builder() 从 2.12 起才有），
             2.6 会让"生成/读取决策表 xlsx"直接 NoClassDefFoundError / NoSuchMethodError，故只留这一条。 -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.18.0</version>
        </dependency>

